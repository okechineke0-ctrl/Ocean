{
  "entities": {
    "Inquiry": {
      "title": "Inquiry",
      "description": "A contact form submission, project quote request, or emergency software issue ticket submitted by a client.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the inquiry record."
        },
        "type": {
          "type": "string",
          "enum": ["quote", "contact", "emergency_issue"],
          "description": "The category of the client message or submission."
        },
        "fullName": {
          "type": "string",
          "description": "Full name of the client."
        },
        "email": {
          "type": "string",
          "description": "Email address of the client."
        },
        "phone": {
          "type": "string",
          "description": "Phone number or WhatsApp contact."
        },
        "companyOrProject": {
          "type": "string",
          "description": "Company name or project title."
        },
        "serviceType": {
          "type": "string",
          "description": "Requested software service or issue category."
        },
        "message": {
          "type": "string",
          "description": "Detailed project description or bug report."
        },
        "budgetRange": {
          "type": "string",
          "description": "Specified budget estimate."
        },
        "timeline": {
          "type": "string",
          "description": "Expected timeline or deadline."
        },
        "urgency": {
          "type": "string",
          "description": "Urgency level for emergency triage."
        },
        "affectedUrlOrSystem": {
          "type": "string",
          "description": "URL or server affected by bug."
        },
        "preferredContact": {
          "type": "string",
          "description": "Preferred channel: WhatsApp, Phone Call, or Email."
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "responded", "resolved", "archived"],
          "description": "Workflow status of the inquiry."
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal notes by Ocean Technologies administrator."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of when the inquiry was created."
        }
      },
      "required": ["type", "fullName", "email", "phone", "createdAt"]
    },
    "Internship": {
      "title": "Internship",
      "description": "Undergraduate student application for Industrial Training (IT), SIWES, or tech internship at Ocean Technologies Agbani hub.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID."
        },
        "registrationNumber": {
          "type": "string",
          "description": "Unique registration identifier (e.g. OCT-INT-2026-XXXX)."
        },
        "fullName": {
          "type": "string",
          "description": "Student full name."
        },
        "email": {
          "type": "string",
          "description": "Student university or personal email address."
        },
        "phone": {
          "type": "string",
          "description": "Student phone number and WhatsApp."
        },
        "school": {
          "type": "string",
          "description": "Higher institution or university (e.g., ESUT, UNN, IMT)."
        },
        "department": {
          "type": "string",
          "description": "Course or department of study."
        },
        "level": {
          "type": "string",
          "description": "Current academic level (e.g., 300 Level, 400 Level)."
        },
        "studentId": {
          "type": "string",
          "description": "Matriculation number or School ID."
        },
        "programType": {
          "type": "string",
          "description": "Program duration (3-Month IT, 6-Month SIWES, 1-Year Attachment, Graduate)."
        },
        "techTrack": {
          "type": "string",
          "description": "Primary tech track interest (Web, Mobile, Backend, DevOps, UI/UX)."
        },
        "preferredStartDate": {
          "type": "string",
          "description": "Desired internship start period."
        },
        "statementOfPurpose": {
          "type": "string",
          "description": "Brief student goals and learning statement."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "under_review", "admitted", "completed", "declined"],
          "description": "Admission workflow status."
        },
        "adminNotes": {
          "type": "string",
          "description": "Administrator interview and endorsement notes."
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of application submission."
        }
      },
      "required": ["registrationNumber", "fullName", "email", "phone", "school", "studentId", "createdAt"]
    }
  },
  "firestore": {
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Public client submissions (quotes, contact messages, and emergency bug tickets) with admin workflow management."
    },
    "/internships/{internshipId}": {
      "schema": "Internship",
      "description": "Student Industrial Training (IT) and SIWES registration applications with admin tracking."
    }
  }
}
