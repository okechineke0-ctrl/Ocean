rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Inquiries Collection:
    // Any prospective client can submit quotes, contact inquiries, or emergency tickets.
    // Read and update access is permitted for management of client inquiries.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.type in ['quote', 'contact', 'emergency_issue']
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() > 0
                    && request.resource.data.email is string
                    && request.resource.data.phone is string;
      allow read, update, delete: if true;
    }
  }
}
